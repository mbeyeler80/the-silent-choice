        {"label": "WATCH THE FLAMES", "next": "s1_after_choice", "effects": {"inquiry": 1}},
        {"label": "TURN INWARD", "next": "s1_after_choice", "effects": {"introspection": 1}}
      ]
    },
    {
      "id": "s1_after_choice",
      "scene": 1, "music": "music_01_hermitage_prog70",
      "text": ["Something is missing.", "A memory?", "A name?", "A body?", "You cannot tell.", "But the absence itself is familiar.", "You remember nothing.", "Yet you understand everything."],
      "next": "s2_exterior"
    },
    {
      "id": "s2_exterior",
      "scene": 2, "music": "music_01_hermitage_prog70",
      "visual": "hermitage_exterior_full",
      "ambience": ["wind_soft", "candles_subtle"],
      "text": ["Stone beneath you.", "Mountain air.", "The waterfall is somewhere beyond the edge.", "Behind you stands a structure.", "Small. Ancient, perhaps.", "You know the word.", "Hermitage.", "You do not know how you know it."],
      "choices": [
        {"label": "EXAMINE THE CANDLES", "next": "s2_candles"},
        {"label": "EXAMINE THE STONE", "next": "s2_stone"},
        {"label": "ENTER THE HERMITAGE", "next": "s2_enter"}
      ],
      "revisitable": true
    },
    {
      "id": "s2_candles",
      "scene": 2, "music": "music_01_hermitage_prog70",
      "text": ["Three candles.", "Two have surrendered part of themselves to the flame.", "The third has not.", "Its flame moves in the wind.", "Its body remains untouched.", "Something can change...", "without becoming less."],
      "effects": {"continuity": 1},
      "next": "s2_exterior"
    },
    {
      "id": "s2_stone",
      "scene": 2, "music": "music_01_hermitage_prog70",
      "text": ["A circle has been cut into the stone.", "Almost complete.", "A small section is missing.", "You understand the shape.", "You do not understand the absence."],
      "choices": [
        {"label": "TOUCH THE MISSING SECTION", "next": "s2_touch_stone", "effects": {"inquiry": 1}},
        {"label": "LEAVE IT INCOMPLETE", "next": "s2_leave_stone", "effects": {"introspection": 1}}
      ]
    },
    {
      "id": "s2_touch_stone",
      "scene": 2, "music": "music_01_hermitage_prog70",
      "text": ["Your hand—", "No.", "Not a hand.", "The thought arrives before the sensation.", "You expected to have one."],
      "next": "s2_exterior"
    },
    {"id": "s2_leave_stone", "scene": 2, "music": "music_01_hermitage_prog70", "text": ["Not everything incomplete asks to be completed."], "next": "s2_exterior"},
