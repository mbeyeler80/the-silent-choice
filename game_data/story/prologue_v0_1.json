      "scene": 1, "music": "music_01_hermitage_prog70",
      "visual": "hermitage_exterior_dim",
      "ambience": ["wind_soft"],
      "text": ["Water.", "Not an image.", "Not yet.", "Only the sound of water falling somewhere beyond you.", "Then wind.", "It moves through grass.", "Across stone.", "Through something you cannot yet name.", "There is light.", "Three flames.", "Candles.", "You know the word.", "You do not know why."],
