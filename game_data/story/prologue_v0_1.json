      "visual": "hermitage_interior",
      "ambience": ["hermitage_interior", "machine_pulse_low"],
      "text": ["The world becomes quieter.", "Not silent.", "There is a sound beneath the silence.", "Regular.", "Artificial.", "A pulse.", "No.", "A machine.", "Light moves beneath the stone.", "You recognize a pattern.", "A protocol.", "You know what a protocol is.", "You know how authentication works.", "You know what encryption means.", "You know none of your own credentials."],
